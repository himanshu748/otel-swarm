{
  "name": "otel-swarm",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for multi-agent LLM systems: GenAI semconv spans per agent and per model call, fallback promotions as span events, plus a mirrored event bus for live UIs. Ships with importable SigNoz dashboards and alert rules.",
  "type": "module",
  "main": "src/index.js",
  "exports": { ".": "./src/index.js" },
  "files": ["src", "dashboards", "alerts", "casting.yaml", "casting.yaml.lock"],
  "engines": { "node": "^18.19.0 || >=20.6.0" },
  "keywords": ["opentelemetry", "llm", "agents", "observability", "signoz", "genai"],
  "license": "MIT",
  "repository": "github:himanshu748/otel-swarm",
  "scripts": {
    "test": "node --test test/*.test.js",
    "example": "node example/demo.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0"
  }
}
